<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.text.Font?>

<!--
  Palette: White #FFFFFF  Teal #45A0AB  Orange #E0733A  Fuchsia #B52D5E  Grey #C4CED4
  Everything sits directly in one AnchorPane, so each item can be dragged freely.
  fx:controller must match your real package, e.g. com.yourapp.RegisterController
-->

<AnchorPane prefHeight="600.0" prefWidth="800.0" style="-fx-background-color: #FFFFFF;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.utsa.cs3443.beef_login.RegisterController">
   <children>
      <!-- Top stripes -->
      <Rectangle fill="#45a0ab" height="22.0" width="800.0" />
      <Rectangle fill="#e0733a" height="10.0" layoutY="22.0" width="800.0" />
      <Rectangle fill="#b52d5e" height="6.0" layoutY="32.0" width="800.0" />

      <!-- Bottom stripes -->
      <Rectangle fill="#b52d5e" height="6.0" layoutY="562.0" width="800.0" />
      <Rectangle fill="#e0733a" height="10.0" layoutY="568.0" width="800.0" />
      <Rectangle fill="#45a0ab" height="22.0" layoutY="578.0" width="800.0" />

      <!-- Card background -->
      <Rectangle arcHeight="12.0" arcWidth="12.0" fill="#ffffff" height="475.0" layoutX="220.0" layoutY="48.0" stroke="#45a0ab" strokeWidth="3.0" width="360.0" />

      <Label alignment="CENTER" layoutX="220.0" layoutY="58.0" prefWidth="360.0" text="CREATE ACCOUNT" textFill="#e0733a">
         <font>
            <Font name="System Bold" size="30.0" />
         </font>
      </Label>

      <!-- Name -->
      <Label layoutX="250.0" layoutY="110.0" text="Name" textFill="#45a0ab">
         <font>
            <Font name="System Bold" size="13.0" />
         </font>
      </Label>
      <TextField fx:id="nameInput" layoutX="250.0" layoutY="132.0" prefHeight="38.0" prefWidth="300.0" promptText="Full name" style="-fx-background-color: #FFFFFF; -fx-text-fill: #000000; -fx-prompt-text-fill: #8a8f94; -fx-border-color: #C4CED4; -fx-border-radius: 4; -fx-background-radius: 4;" />

      <!-- Date of birth -->
      <Label layoutX="250.0" layoutY="172.0" text="Date of Birth" textFill="#45a0ab">
         <font>
            <Font name="System Bold" size="13.0" />
         </font>
      </Label>
      <TextField fx:id="birthdayInput" layoutX="250.0" layoutY="194.0" prefHeight="38.0" prefWidth="300.0" promptText="MM/DD/YYYY" style="-fx-background-color: #FFFFFF; -fx-text-fill: #000000; -fx-prompt-text-fill: #8a8f94; -fx-border-color: #C4CED4; -fx-border-radius: 4; -fx-background-radius: 4;" />

      <!-- Email -->
      <Label layoutX="250.0" layoutY="234.0" text="Email" textFill="#45a0ab">
         <font>
            <Font name="System Bold" size="13.0" />
         </font>
      </Label>
      <TextField fx:id="emailInput" layoutX="250.0" layoutY="256.0" prefHeight="38.0" prefWidth="300.0" promptText="you@example.com" style="-fx-background-color: #FFFFFF; -fx-text-fill: #000000; -fx-prompt-text-fill: #8a8f94; -fx-border-color: #C4CED4; -fx-border-radius: 4; -fx-background-radius: 4;" />

      <!-- Password -->
      <Label layoutX="250.0" layoutY="296.0" text="Password" textFill="#45a0ab">
         <font>
            <Font name="System Bold" size="13.0" />
         </font>
      </Label>
      <PasswordField fx:id="passwordInput" layoutX="250.0" layoutY="318.0" prefHeight="38.0" prefWidth="300.0" promptText="Password" style="-fx-background-color: #FFFFFF; -fx-text-fill: #000000; -fx-prompt-text-fill: #8a8f94; -fx-border-color: #C4CED4; -fx-border-radius: 4; -fx-background-radius: 4;" />

      <!-- Confirm password -->
      <Label layoutX="250.0" layoutY="358.0" text="Confirm Password" textFill="#45a0ab">
         <font>
            <Font name="System Bold" size="13.0" />
         </font>
      </Label>
      <PasswordField fx:id="confirmPasswordInput" layoutX="250.0" layoutY="380.0" prefHeight="38.0" prefWidth="300.0" promptText="Re-enter password" style="-fx-background-color: #FFFFFF; -fx-text-fill: #000000; -fx-prompt-text-fill: #8a8f94; -fx-border-color: #C4CED4; -fx-border-radius: 4; -fx-background-radius: 4;" />

      <Label fx:id="errorLabel" layoutX="250.0" layoutY="422.0" prefHeight="30.0" prefWidth="300.0" textFill="#b52d5e" wrapText="true" />

      <Button fx:id="submitButton" defaultButton="true" layoutX="250.0" layoutY="460.0" mnemonicParsing="false" onAction="#submitClicked" prefHeight="42.0" prefWidth="300.0" style="-fx-background-color: #e0733a; -fx-text-fill: #000000; -fx-font-weight: bold; -fx-font-size: 15; -fx-background-radius: 4; -fx-cursor: hand;" text="CREATE ACCOUNT" />
   </children>
</AnchorPane>
