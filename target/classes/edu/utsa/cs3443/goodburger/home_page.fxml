<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.Ellipse?>
<?import javafx.scene.shape.Rectangle?>

<!--
  Palette: White #FFFFFF  Teal #45A0AB  Orange #E0733A  Fuchsia #B52D5E  Grey #C4CED4
  Home screen: the main hub (matches HomeController in the UML).
  The welcome image is optional; the screen does not depend on an external image asset.
-->

<AnchorPane prefHeight="600.0" prefWidth="800.0" style="-fx-background-color: #FFFFFF;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.utsa.cs3443.goodburger.HomeScreenController">
    <children>
        <!-- Top stripes -->
        <Rectangle fill="#45a0ab" height="22.0" width="800.0" />
        <Rectangle fill="#e0733a" height="10.0" layoutY="22.0" width="800.0" />
        <Rectangle fill="#b52d5e" height="6.0" layoutY="32.0" width="800.0" />

        <!-- Bottom stripes -->
        <Rectangle fill="#b52d5e" height="6.0" layoutY="562.0" width="800.0" />
        <Rectangle fill="#e0733a" height="10.0" layoutY="568.0" width="800.0" />
        <Rectangle fill="#45a0ab" height="22.0" layoutY="578.0" width="800.0" />

        <!-- Logo -->
        <ImageView fx:id="welcomeImage" fitWidth="560.0" layoutX="120.0" layoutY="95.0" pickOnBounds="true" preserveRatio="true" />

        <!-- Profile button (top right) -->
        <Button fx:id="profileButton" layoutX="720.0" layoutY="52.0" mnemonicParsing="false" onAction="#profileClicked" prefHeight="64.0" prefWidth="64.0" style="-fx-background-color: #e6e6e6; -fx-background-radius: 32; -fx-border-color: #45a0ab; -fx-border-width: 3; -fx-border-radius: 32; -fx-cursor: hand;" />
        <Ellipse fill="#8a7f84" layoutX="752.0" layoutY="100.0" mouseTransparent="true" radiusX="18.0" radiusY="11.0" />
        <Circle fill="#8a7f84" layoutX="752.0" layoutY="77.0" mouseTransparent="true" radius="11.0" />

        <!-- Navigation bar -->
        <Button fx:id="homeButton" layoutX="0.0" layoutY="500.0" mnemonicParsing="false" prefHeight="60.0" prefWidth="200.0" style="-fx-background-color: #45a0ab; -fx-text-fill: #FFFFFF; -fx-font-weight: bold; -fx-font-size: 18; -fx-background-radius: 0; -fx-border-color: #FFFFFF; -fx-border-width: 0 1 0 0;" text="home" />
        <Button fx:id="menuButton" layoutX="200.0" layoutY="500.0" mnemonicParsing="false" onAction="#menuClicked" prefHeight="60.0" prefWidth="200.0" style="-fx-background-color: #45a0ab; -fx-text-fill: #FFFFFF; -fx-font-weight: bold; -fx-font-size: 18; -fx-background-radius: 0; -fx-border-color: #FFFFFF; -fx-border-width: 0 1 0 0; -fx-cursor: hand;" text="menu" />
        <Button fx:id="rewardsButton" layoutX="400.0" layoutY="500.0" mnemonicParsing="false" onAction="#rewardsClicked" prefHeight="60.0" prefWidth="200.0" style="-fx-background-color: #45a0ab; -fx-text-fill: #FFFFFF; -fx-font-weight: bold; -fx-font-size: 18; -fx-background-radius: 0; -fx-border-color: #FFFFFF; -fx-border-width: 0 1 0 0; -fx-cursor: hand;" text="rewards" />
        <Button fx:id="checkoutButton" layoutX="600.0" layoutY="500.0" mnemonicParsing="false" onAction="#checkoutClicked" prefHeight="60.0" prefWidth="200.0" style="-fx-background-color: #45a0ab; -fx-text-fill: #FFFFFF; -fx-font-weight: bold; -fx-font-size: 18; -fx-background-radius: 0; -fx-cursor: hand;" text="checkout" />
    </children>
</AnchorPane>