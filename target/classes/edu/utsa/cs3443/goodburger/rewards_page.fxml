<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.text.Font?>

<!--
  Rewards page (module: rewards, author: Fabricio Ocampo).
  Modeled on the team theme already merged in home_page.fxml:
    Palette: White #FFFFFF  Teal #45A0AB  Orange #E0733A  Fuchsia #B52D5E  Grey #C4CED4
  Data comes from the rewards package (ProgressStore, EconomyRules, Achievements),
  so the point economy is the same one the Pipe Flight minigame uses.
  The bottom nav bar matches checkout_page.fxml (styles/rewardsScreen.css).
-->

<AnchorPane prefHeight="600.0" prefWidth="800.0" style="-fx-background-color: #FFFFFF;" stylesheets="@../../../../styles/rewardsScreen.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.utsa.cs3443.goodburger.RewardsPageController">
    <children>
        <!-- Top stripes -->
        <Rectangle fill="#45a0ab" height="22.0" width="800.0" />
        <Rectangle fill="#e0733a" height="10.0" layoutY="22.0" width="800.0" />
        <Rectangle fill="#b52d5e" height="6.0" layoutY="32.0" width="800.0" />

        <!-- Bottom stripes -->
        <Rectangle fill="#b52d5e" height="6.0" layoutY="562.0" width="800.0" />
        <Rectangle fill="#e0733a" height="10.0" layoutY="568.0" width="800.0" />
        <Rectangle fill="#45a0ab" height="22.0" layoutY="578.0" width="800.0" />

        <!-- Title -->
        <Label layoutX="36.0" layoutY="48.0" prefHeight="44.0" prefWidth="430.0" text="Rewards" textFill="#45a0ab">
            <font>
                <Font name="System Bold" size="32.0" />
            </font>
        </Label>

        <!-- Balance card -->
        <Rectangle arcHeight="12.0" arcWidth="12.0" fill="#CFE0F1" height="60.0" layoutX="36.0" layoutY="100.0" stroke="#45a0ab" strokeWidth="2.0" width="430.0" />
        <Label fx:id="pointsLabel" layoutX="52.0" layoutY="110.0" prefHeight="40.0" prefWidth="398.0" text="Current rewards points: 0" textFill="#30373D">
            <font>
                <Font name="System Bold" size="22.0" />
            </font>
        </Label>

        <!-- Redeemable rewards -->
        <Label layoutX="36.0" layoutY="176.0" prefHeight="28.0" prefWidth="300.0" text="Redeem with your points" textFill="#e0733a">
            <font>
                <Font name="System Bold" size="16.0" />
            </font>
        </Label>

        <Label fx:id="reward1Name" layoutX="36.0" layoutY="214.0" prefHeight="44.0" prefWidth="300.0" text="Soda: 300 pts" textFill="#30373D">
            <font>
                <Font name="System Bold" size="17.0" />
            </font>
        </Label>
        <Button fx:id="redeem1Button" layoutX="352.0" layoutY="214.0" mnemonicParsing="false" onAction="#redeem1Clicked" prefHeight="44.0" prefWidth="114.0" styleClass="teal-button" text="Redeem" />

        <Label fx:id="reward2Name" layoutX="36.0" layoutY="270.0" prefHeight="44.0" prefWidth="300.0" text="Fries: 500 pts" textFill="#30373D">
            <font>
                <Font name="System Bold" size="17.0" />
            </font>
        </Label>
        <Button fx:id="redeem2Button" layoutX="352.0" layoutY="270.0" mnemonicParsing="false" onAction="#redeem2Clicked" prefHeight="44.0" prefWidth="114.0" styleClass="teal-button" text="Redeem" />

        <Label fx:id="reward3Name" layoutX="36.0" layoutY="326.0" prefHeight="44.0" prefWidth="300.0" text="Salad: 1000 pts" textFill="#30373D">
            <font>
                <Font name="System Bold" size="17.0" />
            </font>
        </Label>
        <Button fx:id="redeem3Button" layoutX="352.0" layoutY="326.0" mnemonicParsing="false" onAction="#redeem3Clicked" prefHeight="44.0" prefWidth="114.0" styleClass="teal-button" text="Redeem" />

        <!-- Mini game panel -->
        <Rectangle arcHeight="12.0" arcWidth="12.0" fill="#CFE0F1" height="316.0" layoutX="492.0" layoutY="100.0" stroke="#45a0ab" strokeWidth="2.0" width="272.0" />
        <Label layoutX="508.0" layoutY="116.0" prefHeight="30.0" prefWidth="240.0" text="Mini game" textAlignment="CENTER" textFill="#45a0ab">
            <font>
                <Font name="System Bold" size="18.0" />
            </font>
        </Label>
        <Button fx:id="miniGameButton" layoutX="542.0" layoutY="160.0" mnemonicParsing="false" onAction="#miniGameClicked" prefHeight="120.0" prefWidth="172.0" styleClass="teal-button" text="Pipe Flight" wrapText="true" />
        <Label fx:id="miniGameStatsLabel" layoutX="504.0" layoutY="300.0" prefHeight="100.0" prefWidth="248.0" text="Daily bonus + 100 (day 0)   Earned today: 0 / 2000" textAlignment="CENTER" wrapText="true">
            <font>
                <Font size="13.0" />
            </font>
        </Label>

        <!-- Navigation bar (matches checkout_page.fxml) -->
        <Button fx:id="homeButton" layoutX="0.0" layoutY="500.0" mnemonicParsing="false" onAction="#homeButtonClicked" prefHeight="60.0" prefWidth="200.0" style="-fx-background-color: #45a0ab; -fx-text-fill: #FFFFFF; -fx-font-weight: bold; -fx-font-size: 18; -fx-background-radius: 0; -fx-border-color: #FFFFFF; -fx-border-width: 0 1 0 0;" text="home" />
        <Button fx:id="menuButton" layoutX="200.0" layoutY="500.0" mnemonicParsing="false" onAction="#menuButtonClicked" prefHeight="60.0" prefWidth="200.0" style="-fx-background-color: #45a0ab; -fx-text-fill: #FFFFFF; -fx-font-weight: bold; -fx-font-size: 18; -fx-background-radius: 0; -fx-border-color: #FFFFFF; -fx-border-width: 0 1 0 0; -fx-cursor: hand;" text="menu" />
        <Button fx:id="rewardsNavButton" layoutX="400.0" layoutY="500.0" mnemonicParsing="false" prefHeight="60.0" prefWidth="200.0" style="-fx-background-color: #b52d5e; -fx-text-fill: #FFFFFF; -fx-font-weight: bold; -fx-font-size: 18; -fx-background-radius: 0; -fx-border-color: #45a0ab; -fx-border-width: 0 1 0 0;" text="rewards" />
        <Button fx:id="checkoutButton" layoutX="600.0" layoutY="500.0" mnemonicParsing="false" onAction="#checkoutButtonClicked" prefHeight="60.0" prefWidth="200.0" style="-fx-background-color: #45a0ab; -fx-text-fill: #FFFFFF; -fx-font-weight: bold; -fx-font-size: 18; -fx-background-radius: 0; -fx-border-color: #FFFFFF; -fx-border-width: 0 1 0 0; -fx-cursor: hand;" text="checkout" />
    </children>
</AnchorPane>
