<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.Ellipse?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.text.Font?>

<!--
  Palette: White #FFFFFF  Teal #45A0AB  Orange #E0733A  Fuchsia #B52D5E  Grey #C4CED4
  Everything sits directly in one AnchorPane, so each item can be dragged freely.
  fx:controller must match your real package, e.g. com.yourapp.ProfileController
-->

<AnchorPane prefHeight="600.0" prefWidth="800.0" style="-fx-background-color: #FFFFFF;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.utsa.cs3443.goodburger.ProfileController">
    <children>
        <!-- Top stripes -->
        <Rectangle fill="#45a0ab" height="22.0" width="800.0" />
        <Rectangle fill="#e0733a" height="10.0" layoutY="22.0" width="800.0" />
        <Rectangle fill="#b52d5e" height="6.0" layoutY="32.0" width="800.0" />

        <!-- Bottom stripes -->
        <Rectangle fill="#b52d5e" height="6.0" layoutY="562.0" width="800.0" />
        <Rectangle fill="#e0733a" height="10.0" layoutY="568.0" width="800.0" />
        <Rectangle fill="#45a0ab" height="22.0" layoutY="578.0" width="800.0" />

        <!-- Card background -->
        <Rectangle arcHeight="12.0" arcWidth="12.0" fill="#ffffff" height="470.0" layoutX="60.0" layoutY="62.0" stroke="#45a0ab" strokeWidth="3.0" visible="false" width="680.0" />

        <Button fx:id="backButton" layoutX="80.0" layoutY="78.0" mnemonicParsing="false" onAction="#backClicked" prefHeight="32.0" prefWidth="90.0" style="-fx-background-color: #FFFFFF; -fx-text-fill: #45a0ab; -fx-font-weight: bold; -fx-border-color: #45a0ab; -fx-border-width: 2; -fx-border-radius: 4; -fx-background-radius: 4; -fx-cursor: hand;" text="&lt; Back" />

        <!-- Avatar placeholder -->
        <Circle fill="#e6e6e6" layoutX="190.0" layoutY="240.0" radius="70.0" stroke="#45a0ab" strokeWidth="3.0" />
        <Ellipse fill="#8a7f84" layoutX="190.0" layoutY="285.0" radiusX="45.0" radiusY="25.0" />
        <Circle fill="#8a7f84" layoutX="190.0" layoutY="225.0" radius="24.0" />

        <Label fx:id="usernameLabel" alignment="CENTER" layoutX="90.0" layoutY="330.0" prefWidth="200.0" text="Username" textFill="#e0733a">
            <font>
                <Font name="System Bold" size="20.0" />
            </font>
        </Label>

        <!-- Email -->
        <Label layoutX="330.0" layoutY="125.0" text="Email" textFill="#45a0ab">
            <font>
                <Font name="System Bold" size="13.0" />
            </font>
        </Label>
        <Label fx:id="emailLabel" alignment="CENTER_LEFT" layoutX="330.0" layoutY="147.0" prefHeight="38.0" prefWidth="360.0" style="-fx-background-color: #FFFFFF; -fx-border-color: #C4CED4; -fx-border-radius: 4; -fx-background-radius: 4; -fx-padding: 0 10 0 10;" text="User123@Domain.com" textFill="#222222" />

        <!-- Birthday -->
        <Label layoutX="330.0" layoutY="195.0" text="Birthday" textFill="#45a0ab">
            <font>
                <Font name="System Bold" size="13.0" />
            </font>
        </Label>
        <Label fx:id="birthdayLabel" alignment="CENTER_LEFT" layoutX="330.0" layoutY="217.0" prefHeight="38.0" prefWidth="360.0" style="-fx-background-color: #FFFFFF; -fx-border-color: #C4CED4; -fx-border-radius: 4; -fx-background-radius: 4; -fx-padding: 0 10 0 10;" text="Birthday" textFill="#222222" />

        <!-- Points -->
        <Label layoutX="330.0" layoutY="265.0" text="Points" textFill="#45a0ab">
            <font>
                <Font name="System Bold" size="13.0" />
            </font>
        </Label>
        <Label fx:id="pointsLabel" alignment="CENTER_LEFT" layoutX="330.0" layoutY="287.0" prefHeight="38.0" prefWidth="360.0" style="-fx-background-color: #FFFFFF; -fx-border-color: #C4CED4; -fx-border-radius: 4; -fx-background-radius: 4; -fx-padding: 0 10 0 10;" text="Points" textFill="#222222" />

        <!-- Action buttons -->
        <Button fx:id="logoutButton" layoutX="332.0" layoutY="342.0" mnemonicParsing="false" onAction="#logoutClicked" prefHeight="38.0" prefWidth="154.0" style="-fx-background-color: #e0733a; -fx-text-fill: #000000; -fx-font-weight: bold; -fx-font-size: 14; -fx-background-radius: 4; -fx-cursor: hand;" text="LOG OUT" />
        <Button fx:id="createAccountButton" layoutX="414.0" layoutY="340.0" mnemonicParsing="false" onAction="#createAccountClicked" prefHeight="42.0" prefWidth="170.0" style="-fx-background-color: #45a0ab; -fx-text-fill: #FFFFFF; -fx-font-weight: bold; -fx-font-size: 14; -fx-background-radius: 4; -fx-cursor: hand;" text="CREATE ACCOUNT" visible="false" />
        <Button fx:id="deleteAccountButton" layoutX="534.0" layoutY="342.0" mnemonicParsing="false" onAction="#deleteAccountClicked" prefHeight="38.0" prefWidth="154.0" style="-fx-background-color: #b52d5e; -fx-text-fill: #FFFFFF; -fx-font-weight: bold; -fx-font-size: 14; -fx-background-radius: 4; -fx-cursor: hand;" text="DELETE ACCOUNT" />
    </children>
</AnchorPane>