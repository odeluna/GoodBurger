<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.shape.Rectangle?>

<!--
  All colors and fonts come from style.css (same folder as this file).
  Everything sits directly in one AnchorPane, so each item can be dragged freely.
-->

<AnchorPane prefHeight="600.0" prefWidth="800.0" styleClass="root-pane" stylesheets="@../../../../styles/style.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.utsa.cs3443.goodburger.SignInController">
   <children>
      <!-- Top stripes -->
      <Rectangle height="22.0" styleClass="stripe-teal" width="800.0" />
      <Rectangle height="10.0" layoutY="22.0" styleClass="stripe-orange" width="800.0" />
      <Rectangle height="6.0" layoutY="32.0" styleClass="stripe-fuchsia" width="800.0" />

      <!-- Bottom stripes -->
      <Rectangle height="6.0" layoutY="562.0" styleClass="stripe-fuchsia" width="800.0" />
      <Rectangle height="10.0" layoutY="568.0" styleClass="stripe-orange" width="800.0" />
      <Rectangle height="22.0" layoutY="578.0" styleClass="stripe-teal" width="800.0" />

      <!-- Card background -->
      <Rectangle height="440.0" layoutX="220.0" layoutY="80.0" styleClass="card" width="360.0" />

      <Label alignment="CENTER" layoutX="220.0" layoutY="100.0" prefWidth="360.0" styleClass="page-title-large" text="SIGN IN" />
      <Label alignment="CENTER" layoutX="220.0" layoutY="150.0" prefWidth="360.0" styleClass="subtitle" text="Welcome back" />

      <Label layoutX="250.0" layoutY="195.0" styleClass="field-label" text="Email" />
      <TextField fx:id="emailInput" layoutX="250.0" layoutY="212.0" prefHeight="38.0" prefWidth="300.0" promptText="you@example.com" />

      <Label layoutX="250.0" layoutY="272.0" styleClass="field-label" text="Password" />
      <PasswordField fx:id="passwordInput" layoutX="250.0" layoutY="289.0" prefHeight="38.0" prefWidth="300.0" promptText="Password" />

      <Label fx:id="errorLabel" layoutX="250.0" layoutY="335.0" prefHeight="36.0" prefWidth="300.0" styleClass="error-label" wrapText="true" />

      <Button fx:id="signInButton" defaultButton="true" layoutX="250.0" layoutY="378.0" mnemonicParsing="false" onAction="#signInClicked" prefHeight="42.0" prefWidth="300.0" styleClass="primary-button" text="SIGN IN" />

      <!-- Create account / guest, under Sign In -->
      <Button fx:id="createAccountButton" layoutX="341.0" layoutY="438.0" mnemonicParsing="false" onAction="#createAccountClicked" styleClass="link-button" text="Create Account" />
      <Button fx:id="guestButton" layoutX="332.0" layoutY="467.0" mnemonicParsing="false" onAction="#guestClicked" styleClass="link-button" text="Continue as Guest" />
   </children>
</AnchorPane>
