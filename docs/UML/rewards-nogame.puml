@startuml
' Rewards JavaFX — class diagram WITHOUT the Pipe Flight game
' Arrows per CS 3443 notes (10_midterm_exam_review.pdf slide 8 + oop_review.pdf).
!pragma layout smetana
' Source of truth: RewardsRun/RewardsJavaFX/src/main/java/rewards/*.java
' Drops the game cluster: PipeFlightGame (+ Input / Rect / Hazard),
' PipeFlightCanvas, SpriteAtlas, GameAudio, RewardsApp.GameSession.
title Rewards JavaFX — UML Class Diagram (without Pipe Flight)
skinparam backgroundColor white
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam class {
  BackgroundColor #FDFDFD
  BorderColor #333333
  ArrowColor #555555
  FontName "DejaVu Sans Mono"
  FontSize 11
  ClassFontStyle bold
  ClassFontSize 13
  AttributeFontSize 10
  MethodFontSize 10
}
skinparam nodesep 30
skinparam ranksep 36

' ============================ ECONOMY (data, no deps) ============================

class EconomyRules {
  <<utility - no instances>>
  {static} + STARTING_POINTS : int = 500
  {static} + PLAY_COST : int = 500
  {static} + DAILY_EARNINGS_CAP : int = 2000
  {static} + POINTS_PER_PIPE : int = 1
  {static} + DAILY_BONUS_BASE : int = 100
  {static} + DAILY_BONUS_PER_STREAK_DAY : int = 25
  {static} + DAILY_BONUS_MAX : int = 300
  - EconomyRules()
}

class Achievements {
  <<utility - no instances>>
  {static} # ALL : Definition[]
  - Achievements()
}

class "Achievements.Definition" as AchievementDef <<record>> {
  + id : String
  + name : String
  + grant : int
  + how : String
}

' ============================ PERSISTENCE ============================

class ProgressStore {
  - file : Path
  - clock : Clock
  - today : LocalDate
  - points : int
  - earnedToday : int
  - earnedDate : LocalDate
  - redeemed : int[3]
  - streakDays : int
  - lastBonusDate : LocalDate
  - bestRun : int
  - gamesPlayed : int
  - pokerWins : int
  - doubledToday : boolean
  - unlocked : List<String>
  - onAchievement : Consumer<AchievementEvent>
  - gambleDeadline : Supplier<LocalDate>
  + ProgressStore(Path file, Clock clock)
  {static} + defaultPath() : Path
  + points() : int
  + earnedToday() : int
  + remainingToday() : int
  + redeemedCount(int index) : int
  + totalRedemptions() : int
  + canRedeem(int index) : boolean
  + hasUnlocked(String id) : boolean
  + unlockedDefinitions() : List<Definition>
  + streakDays() : int
  + dailyBonusForToday() : int
  + bestRun() : int
  + gamesPlayed() : int
  + pokerWins() : int
  + perPipeCapReached() : boolean
  + bonusClaimedToday() : boolean
  + gambleOpen() : boolean
  + tradeBackValue(int index) : double
  + onAchievementAwarded(Consumer<AchievementEvent>) : void
  + setGambleDeadlineSupplier(Supplier<LocalDate>) : void
  + claimDailyBonus() : int
  + rollDay() : void
  + startPlay() : StartResult
  + finishPlay(int pipesPassed) : EarnResult
  + recordPokerWin() : List<AchievementEvent>
  + recordGamble(boolean win, EarnResult previous) : EarnResult
  + redeem(int index) : boolean
  + tradeIn(int index) : int
  - grant(DefinitionRef ref, List<AchievementEvent> fired) : int
  - fire(List<AchievementEvent> events) : void
  - load() : void
  - integer(String text, int fallback) : int
  - save() : void
}

class "ProgressStore.StartResult" as StartResult <<enum>> {
  STARTED
  NOT_ENOUGH_POINTS
  DAILY_CAP_REACHED
}

class "ProgressStore.AchievementEvent" as StoreAchievementEvent <<record>> {
  + definition : Definition
  + grant : int
}

class "ProgressStore.EarnResult" as EarnResult <<record>> {
  + baseAward : int
  + dailyBonus : int
  + doubleBonus : int
  + achievements : int
  + unlocked : List<AchievementEvent>
}

class "ProgressStore.DefinitionRef" as DefinitionRef <<enum - private>> {
  FIRST_PLAY
  PIPES_10
  PIPES_25
  POKER_WIN
  STREAK_3
  REDEMPTIONS_5
  + definition : Definition
  - DefinitionRef(String id)
}

' ============================ POKER ============================

class Poker {
  <<utility - no instances>>
  {static} + evaluateFive(List<Card> hand) : HandRank
  {static} + bestFive(List<Card> cards) : BestHand
  - Poker()
}

class "Poker.Card" as Card <<record>> {
  + suit : String
  + rank : int
  + value() : String
  + suitLetter() : String
  + red() : boolean
}

class "Poker.HandRank" as HandRank <<record - implements Comparable>> {
  + category : int
  + tieBreak : List<Integer>
  + name() : String
  + compareTo(HandRank other) : int
}

class "Poker.BestHand" as BestHand <<record>> {
  + cards : List<Card>
  + rank : HandRank
}

class "Poker.Deck" as Deck {
  - cards : List<Card>
  + Deck(Random random, List<Card> excluded)
  + size() : int
  + contains(Card card) : boolean
  + drawTop() : Card
  + drawBottom() : Card
  + addBottom(Card card) : void
  + shuffle(Random random) : void
}

class "Poker.Round" as Round {
  + playerCards : List<Card>
  + dealerCards : List<Card>
  + playerBest : BestHand
  + dealerBest : BestHand
  + revealed : boolean
  + lost : boolean
  + powerUsed : boolean
  + upgradeDue : boolean
  + outcome : String
  + Round(List<Card> playerCards, Deck deck)
}

' ============================ JDK (for hierarchy arrows) ============================

abstract class "javafx.application.Application" as JFXApp <<JDK - abstract>> {
  + {abstract} start(Stage stage) : void
}

interface Comparable <<JDK - java.util>> {
  + {abstract} compareTo(T o) : int
}

' ============================ UI ============================

class RewardsApp {
  <<entry point - main()>>
  {static} - BLUE : String
  {static} - PEACH : String
  {static} - ORANGE : String
  {static} - INK : Color
  - stage : Stage
  - progress : ProgressStore
  ' (game fields sprites / previousGame / session omitted — no-game view)
  + main(String[] args) : void
  + start(Stage stage) : void
  {static} - snapshot(Scene scene, Path output) : void
  - showPage(String page) : void
  - toast(String message) : void
  {static} - shell() : Pane
  {static} - box(double x, double y, double width, double height, double radius, String fill, double border) : Rectangle
  {static} - label(String value, double x, double y, double width, double height, int size, boolean bold) : Label
  {static} - button(String value, double x, double y, double width, double height, String fill, int size) : Button
  - rewards(Pane root) : void
  - home(Pane root) : void
  - menu(Pane root) : void
  - checkout(Pane root) : void
  - stats(Pane root) : void
  - navigation(Pane root, String current) : void
  ' startGame() omitted — launches the (removed) Pipe Flight game
  - showInfo(String title, String message) : void
  - showError(String title, Exception error) : void
}

' ============================ RELATIONSHIPS ============================
' CS 3443 vocabulary (midterm_review, slide 8): dependency, unidirectional
' association, bidirectional association, aggregation, composition,
' realization, generalization. oop_review.pdf: "has-a" = composition.
'   *--        COMPOSITION  (FILLED diamond, owner end) — has-a, owns
'   o--        AGGREGATION  (open diamond, owner end)   — weaker has-a
'   ..>        DEPENDENCY   (dashed, arrow)             — uses/reads
'   --|>       GENERALIZATION (solid, open triangle)    — extends
'   ..|>       REALIZATION  (dashed, open triangle)     — implements

' --- economy / persistence ---
ProgressStore ..> EconomyRules : reads caps
ProgressStore ..> Achievements : reads definitions
ProgressStore ..> AchievementDef : references
ProgressStore ..> StartResult : startPlay() returns
ProgressStore ..> EarnResult : finishPlay() returns
ProgressStore ..> StoreAchievementEvent : fired events
ProgressStore ..> DefinitionRef : grant()
DefinitionRef ..> AchievementDef : resolves to
StoreAchievementEvent ..> AchievementDef : carries

' --- poker (owned fields -> composition, per oop_review "has-a") ---
Poker ..> Card : creates / evaluates
Poker ..> HandRank : evaluateFive returns
Poker ..> BestHand : bestFive returns
Deck *-- "*" Card : <<composition>> (cards)
Round *-- Deck : <<composition>> (draws 8 dealer cards)
Round "1" *-- "8" Card : <<composition>> (playerCards)
Round "1" *-- "8" Card : <<composition>> (dealerCards)
Round "1" *-- "1" BestHand : <<composition>> (playerBest)
Round "1" *-- "1" BestHand : <<composition>> (dealerBest)
BestHand "1" *-- "5" Card : <<composition>> (cards)
BestHand *-- HandRank : <<composition>> (rank)

' --- hierarchy (JDK level) ---
RewardsApp --|> JFXApp : <<generalization>> (extends Application)
HandRank ..|> Comparable : <<realization>> (implements Comparable)

' --- UI / app (game-free) ---
RewardsApp *-- ProgressStore : <<composition>> (progress)

@enduml
